# Required. Copy the Project URL from the Supabase Dashboard's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Required. Copy the publishable key from Connect or Settings > API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Server only. Never prefix this with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# Required for globally shared order rate limiting in serverless deployments.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
